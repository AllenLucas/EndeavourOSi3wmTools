{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arch Tools",
  "version": "0.2.0",
  "identifier": "io.github.arch-tools",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Arch Tools",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
